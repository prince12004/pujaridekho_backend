NODE_ENV=development
PORT=4000
API_VERSION=v1
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pujaridekho
CLIENT_URL=http://localhost:3000
# Must be publicly reachable for PayU to POST payment callbacks to (use an
# ngrok tunnel in local dev; the real domain in production).
API_PUBLIC_URL=http://localhost:4000
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
ADMIN_JWT_SECRET=change-this-to-a-third-long-random-string

# Only used once by `pnpm seed:admin` to create the first Super Admin — never
# read by the server itself, so no credentials live in application code.
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@pujaridekho.com
ADMIN_SEED_PASSWORD=change-this-before-running-the-seed

# PayU's own publicly-documented sandbox test credentials (safe to commit) —
# replace with your real merchant key/salt via env vars before going live.
PAYU_MODE=test
PAYU_MERCHANT_KEY=gtKFFx
PAYU_MERCHANT_SALT=eCwWELxi

# Media Library uploads (pooja/festival/product/blog/pandit images) go to
# Cloudinary when all three vars below are set. Leave unset to fall back to
# local disk storage under /uploads (fine for local dev).
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Static key the external CRM app sends as `Authorization: Bearer <key>` on
# the /crm/* endpoints (separate from admin JWT auth).
WEBSITE_API_KEY=change-this-to-a-long-random-string-shared-with-the-crm

# Sends the homepage "Book Your Puja" widget submissions by email. Leave
# unset to skip sending (logged instead) — fine for local dev. For Gmail,
# SMTP_USER is the sending address and SMTP_PASS is a 16-character App
# Password (Google Account → Security → 2-Step Verification → App passwords),
# NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=your-sending-address@gmail.com
# SMTP_PASS=your-16-character-app-password
SMTP_FROM=Pujari Dekho <pujaridekho@gmail.com>
LEAD_NOTIFICATION_EMAIL=pujaridekho@gmail.com
