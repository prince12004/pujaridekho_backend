NODE_ENV=development
PORT=4000
API_VERSION=v1
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pujaridekho
CLIENT_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
ADMIN_JWT_SECRET=change-this-to-a-third-long-random-string

ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@pujaridekho.com
ADMIN_SEED_PASSWORD=change-this-before-running-the-seed

PAYU_MODE=test
PAYU_MERCHANT_KEY=gtKFFx
PAYU_MERCHANT_SALT=eCwWELxi

# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

WEBSITE_API_KEY=change-this-to-a-long-random-string-shared-with-the-crm

# CRM backoffice (salespeople + CRM admin/superadmin) — merged in from
# pujaridekhocrm/backend. Separate JWT secret/logins from the admin panel
# above; see src/middlewares/crm-auth.ts.
CRM_JWT_SECRET=change-this-to-a-long-random-string
CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=change-this-before-deploying
CRM_SUPERADMIN_USERNAME=owner
CRM_SUPERADMIN_PASSWORD=change-this-before-deploying
# Social lead webhooks — scaffolded only, not wired to a real integration.
# META_WEBHOOK_VERIFY_TOKEN=set-this-when-registering-the-webhook-in-meta-app-dashboard
# WHATSAPP_APP_SECRET=needed-later-to-verify-WhatsApp-Business-Cloud-API-signatures
# WEBSITE_WEBHOOK_VERIFY_TOKEN=only-needed-if-something-external-still-posts-to-/crm-webhooks/website-booking

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_USER=your-sending-address@gmail.com
# SMTP_PASS=your-16-character-app-password
