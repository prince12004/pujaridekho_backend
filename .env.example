NODE_ENV=development
PORT=4000
API_VERSION=v1
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/pujaridekho
CLIENT_URL=http://localhost:3000
# Must be publicly reachable for PayU to POST payment callbacks to (use an
# ngrok tunnel in local dev; the real domain in production).
API_PUBLIC_URL=http://localhost:4000
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-this-to-a-different-long-random-string
ADMIN_JWT_SECRET=change-this-to-a-third-long-random-string

# Only used once by `pnpm seed:admin` to create the first Super Admin — never
# read by the server itself, so no credentials live in application code.
ADMIN_SEED_NAME=Super Admin
ADMIN_SEED_EMAIL=admin@pujaridekho.com
ADMIN_SEED_PASSWORD=change-this-before-running-the-seed

# PayU's own publicly-documented sandbox test credentials (safe to commit) —
# replace with your real merchant key/salt via env vars before going live.
PAYU_MODE=test
PAYU_MERCHANT_KEY=gtKFFx
PAYU_MERCHANT_SALT=eCwWELxi

# Media Library uploads (pooja/festival/product/blog/pandit images) go to this
# Google Cloud Storage bucket when both vars below are set. Leave unset to fall
# back to local disk storage under /uploads (fine for local dev).
# GCS_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
