              ]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9999999999\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customer-auth/verify-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer-auth",
                "verify-otp"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "if (d && d.data) { if (d.data.accessToken) pm.collectionVariables.set('customer_token', d.data.accessToken); if (d.data.refreshToken) pm.collectionVariables.set('customer_refresh_token', d.data.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{customer_refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/customer-auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "customer-auth",
                "refresh"
              ]
            }
          }
        },
