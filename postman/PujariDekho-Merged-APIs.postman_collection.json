    {
      "name": "Pandit Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"9999999999\",\n  \"password\": \"<password>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pandit-auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pandit-auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "if (d && d.data && d.data.token) { pm.collectionVariables.set('pandit_token', d.data.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password (send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"9999999999\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pandit-auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pandit-auth",
                "forgot-password"
              ]
            }
          }
        },
        {
          "name": "Reset password (with OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile_number\": \"9999999999\",\n  \"otp\": \"123456\",\n  \"new_password\": \"newpass123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pandit-auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pandit-auth",
                "reset-password"
              ]
            }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pandit_token}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"<old>\",\n  \"new_password\": \"<new>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pandit-auth/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pandit-auth",
                "change-password"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{pandit_token}}"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/pandit-auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pandit-auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
