{
  "info": {
    "name": "PujariDekho — CRM + Pandit App + Customer Auth (merged backend)",
    "description": "Covers the endpoints added/merged into apps/api for: the CRM backoffice (salespeople + inquiries, migrated from the old standalone pujaridekhocrm/backend), the pujaripandit_app mobile backend, and customer auth used by pujariuser_app. All routes are mounted under {{base_url}} which should already include /api/v1, e.g. http://localhost:4000/api/v1 for local dev, or https://pujaridekho.com/api/v1 in production (served off the main domain at /api, reverse-proxied to apps/api — no separate subdomain).\n\nTokens: run the relevant *Login* request first — each has a test script that saves the returned token into the matching collection variable (crm_token / pandit_token / customer_token) which every other request in that folder uses automatically via Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "crm_token",
      "value": ""
    },
    {
      "key": "pandit_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "customer_refresh_token",
      "value": ""
    },
    {
      "key": "inquiry_id",
      "value": ""
    },
    {
      "key": "booking_id",
      "value": ""
    },
    {
      "key": "salesperson_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "CRM Auth",
      "item": [
        {
          "name": "Login (admin / superadmin / salesperson)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin\",\n  \"password\": \"admin@123\"\n}\n\n// For a salesperson, use their phone as identifier + their password.\n// For the read-only owner role, use the CRM_SUPERADMIN_USERNAME/PASSWORD."
            },
            "url": {
              "raw": "{{base_url}}/crm-auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "crm-auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const d = pm.response.json();",
                  "if (d && d.data && d.data.token) { pm.collectionVariables.set('crm_token', d.data.token); }"
                ]
              }
            }
          ]
        }
      ]
    },
